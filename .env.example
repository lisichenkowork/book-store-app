# Copy to `.env` and adjust if needed: `cp .env.example .env`
# docker-compose reads these values (ports + DB credentials).

# --- MySQL ---
MYSQLDB_ROOT_PASSWORD=changeme      # root password for the MySQL container
MYSQLDB_DATABASE=book_app
MYSQLDB_LOCAL_PORT=3307             # host port -> connect DBeaver to localhost:3307
MYSQLDB_DOCKER_PORT=3306

# --- Spring Boot app ---
SPRING_LOCAL_PORT=8088             # host port -> API at http://localhost:8088
SPRING_DOCKER_PORT=8080
DEBUG_PORT=5005                    # JDWP remote-debug port

# --- Angular frontend (nginx) ---
FRONTEND_LOCAL_PORT=4200           # host port -> UI at http://localhost:4200
